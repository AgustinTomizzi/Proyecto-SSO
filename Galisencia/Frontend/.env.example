# Base de la API de Galileo Auth. Con `npm run dev`, Vite reenvía /api a http://localhost:80
# (vite.config.ts); en Docker lo hace nginx. Alternativa en dev: http://localhost:8080/api
# con `docker compose --profile dev up`.
VITE_API_URL=/api
# URL de la app Galiservas (enlace del menú lateral).
VITE_GALISERVAS_URL=http://localhost:5174
