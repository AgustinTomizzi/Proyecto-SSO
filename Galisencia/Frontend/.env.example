# Base de la API. En Docker y con `npm run dev` es /api: en Docker la sirve el
# proxy de entrada y en dev Vite la reenvía a VITE_PROXY_API
# (por defecto http://localhost:8080, `docker compose --profile dev up`).
VITE_API_URL=/api
# Enlace del menú lateral a Galiservas. En Docker es /galiservas/ (mismo origen);
# en dev, la URL del Vite de Galiservas.
VITE_GALISERVAS_URL=http://localhost:5174/galiservas/
