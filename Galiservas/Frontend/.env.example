# Base de la API de Galileo Auth, sin barra final. Solo se usa con `npm run dev`:
# requiere `docker compose --profile dev up`. En Docker el build usa /api (ver docker-compose.yml).
VITE_API_URL=http://localhost:8080/api

# URL de la app Galisencia (se usa para el botón "Volver a Galisencia").
VITE_GALISENCIA_URL=http://localhost:3000
