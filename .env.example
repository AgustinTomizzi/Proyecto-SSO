# Copiá este archivo a .env (no se versiona) y cambiá TODAS las contraseñas.
#   cp .env.example .env

# Contraseña de root de MySQL. Solo para administrar la base; el backend no la usa.
MYSQL_ROOT_PASSWORD=cambiar-por-una-contraseña-larga

# Usuario con el que se conecta el backend: solo SELECT/INSERT/UPDATE/DELETE
# sobre ProyectoEstela. Lo crea db/00-usuario-app.sh al inicializar el volumen.
DB_APP_USER=galileo_app
DB_APP_PASSWORD=cambiar-por-otra-contraseña-larga

# Entorno del backend. dev: CORS abierto a localhost y cookie de sesion sin
# Secure (sirve por HTTP). prod: cookie Secure (requiere HTTPS) y CORS solo
# para CORS_ALLOWED_ORIGINS.
APP_ENV=dev
# Origenes extra permitidos por CORS, separados por coma (ej. https://escuela.edu.ar).
CORS_ALLOWED_ORIGINS=
# Minutos de inactividad antes de cerrar la sesion.
SESSION_TIMEOUT_MINUTES=30

# Punto de entrada (proxy). Galisencia en http://localhost:3000/, Galiservas en
# /galiservas/ y la API en /api/.
PROXY_PUERTO=3000
# HTTPS: PROXY_MODO=https, certificados fullchain.pem y privkey.pem en
# TLS_CERT_DIR y APP_ENV=prod.
PROXY_MODO=http
PROXY_PUERTO_HTTPS=3443
TLS_CERT_DIR=./proxy/certs

# Autenticación (docs/AUTENTICACION.md). "local": email y contraseña, y además
# los botones de los proveedores OIDC configurados abajo. "oidc": solo ingreso
# institucional (el formulario local se rechaza).
AUTH_PROVIDER=local
# URL pública del sitio: arma el redirect_uri de OIDC ({APP_URL}/api/oidc_callback.php).
# Vacía usa http://localhost:{PROXY_PUERTO}.
APP_URL=

# Ingreso con Google Workspace: credencial OAuth "Aplicación web" con el
# redirect_uri de arriba. Vacío = sin botón de Google.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
# Ingreso con Microsoft Entra ID: ID del tenant (GUID) y registro de aplicación.
OIDC_MICROSOFT_TENANT=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
# Solo pruebas (perfil oidc-prueba, ignorado con APP_ENV=prod):
#   OIDC_PRUEBA_ISSUER=http://oidc-prueba:9100
#   OIDC_PRUEBA_CLIENT_ID=galileo-pruebas
#   OIDC_PRUEBA_CLIENT_SECRET=<cualquier valor>
OIDC_PRUEBA_ISSUER=
OIDC_PRUEBA_CLIENT_ID=
OIDC_PRUEBA_CLIENT_SECRET=

# Notificaciones por email (servicio "notificador"). Por defecto van a Mailpit,
# un buzón de prueba en http://localhost:8025 (MAILPIT_PUERTO). En producción:
# SMTP_HOST, SMTP_PORT (587), SMTP_SECURE=starttls (o tls para 465), SMTP_USER,
# SMTP_PASS y un SMTP_FROM del dominio. SMTP_HOST vacío deshabilita el envío
# (las notificaciones quedan en la cola).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Galileo <no-responder@galileo.edu.ar>
NOTIF_INTERVALO=30
MAILPIT_PUERTO=8025
