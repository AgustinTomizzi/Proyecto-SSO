# Copiá este archivo a .env (no se versiona) y cambiá TODAS las contraseñas.
#   cp .env.example .env

# Contraseña de root de MySQL. Solo para administrar la base; el backend no la usa.
MYSQL_ROOT_PASSWORD=cambiar-por-una-contraseña-larga

# Usuario con el que se conecta el backend: solo SELECT/INSERT/UPDATE/DELETE
# sobre ProyectoEstela. Lo crea db/00-usuario-app.sh al inicializar el volumen.
DB_APP_USER=galileo_app
DB_APP_PASSWORD=cambiar-por-otra-contraseña-larga

# Entorno del backend. dev: CORS abierto a localhost y cookie de sesion sin
# Secure (sirve por HTTP). prod: cookie Secure (requiere HTTPS) y CORS solo
# para CORS_ALLOWED_ORIGINS.
APP_ENV=dev
# Origenes extra permitidos por CORS, separados por coma (ej. https://escuela.edu.ar).
CORS_ALLOWED_ORIGINS=
# Minutos de inactividad antes de cerrar la sesion.
SESSION_TIMEOUT_MINUTES=30

# Punto de entrada (proxy). Galisencia en http://localhost:3000/, Galiservas en
# /galiservas/ y la API en /api/.
PROXY_PUERTO=3000
# HTTPS: PROXY_MODO=https, certificados fullchain.pem y privkey.pem en
# TLS_CERT_DIR y APP_ENV=prod.
PROXY_MODO=http
PROXY_PUERTO_HTTPS=3443
TLS_CERT_DIR=./proxy/certs

# Proveedor de autenticación del backend. Hoy solo "local" (email y
# contraseña); ver docs/AUTENTICACION.md para OIDC.
AUTH_PROVIDER=local
